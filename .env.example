# Server-side only. Leave blank for deterministic DEMO mode.
# Spring Boot reads exported environment variables, not this file automatically.
CLINECAN_LLM_API_KEY=
CLINECAN_LLM_MODEL=gpt-4o-mini
# Responses API base URL. Legacy full /chat/completions or /responses URLs are normalized.
CLINECAN_LLM_ENDPOINT=https://api.openai.com/v1
# Per stage, 1-60 seconds. Three sequential provider calls per request.
CLINECAN_LLM_TIMEOUT_SECONDS=45

# Phase 3: build the trusted sandbox image first: docker build -t clinecan-sandbox:phase3 sandbox
CLINECAN_SANDBOX_ENABLED=true
CLINECAN_SANDBOX_IMAGE=clinecan-sandbox:phase3
CLINECAN_SANDBOX_TIMEOUT_SECONDS=90
CLINECAN_SANDBOX_MAX_MEMORY_MB=512
CLINECAN_SANDBOX_MAX_CPUS=1
CLINECAN_SANDBOX_MAX_CONCURRENT=2
CLINECAN_REPAIR_MAX_ATTEMPTS=2
